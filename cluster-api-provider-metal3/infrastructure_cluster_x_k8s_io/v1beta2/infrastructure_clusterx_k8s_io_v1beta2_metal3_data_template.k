        _regex_match(str(string), r"^(([0-9a-fA-F]{1,4}:){7,7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))$") if string


schema InfrastructureClusterxK8sIoV1beta2Metal3DataTemplateSpecNetworkDataNetworksIPV6SLAACItems0RoutesItems0GatewayFromPoolAnnotation:
    r"""
    fromPoolAnnotation allows specifying the pool name via an annotation on
    a Machine, Metal3Machine, or BareMetalHost object.
    When set, fromIPPool and fromPoolRef are ignored.

    Attributes
    ----------
    annotation : str, default is Undefined, required
        annotation is the key of the annotation that contains the pool name.
        The annotation value should be a string containing the pool name.
    object : str, default is Undefined, required
        object is the type of the object from which we retrieve the annotation
    """


    annotation: str

    object: "machine" | "metal3machine" | "baremetalhost"


    check:
        len(annotation) <= 512
        len(annotation) >= 1


schema InfrastructureClusterxK8sIoV1beta2Metal3DataTemplateSpecNetworkDataNetworksIPV6SLAACItems0RoutesItems0GatewayFromPoolRef:
    r"""
    fromPoolRef is a reference to a IP pool to fetch the gateway from

    Attributes
    ----------
    apiGroup : str, default is "ipam.metal3.io", optional
        apiGroup of the IPPool.
        apiGroup must be fully qualified domain name.
    kind : str, default is "IPPool", optional
        kind of the IPPool.
        kind must consist of alphanumeric characters or '-', start with an alphabetic character, and end with an alphanumeric character.
    name : str, default is Undefined, required
        name of the IPPool.
        name must consist of lower case alphanumeric characters, '-' or '.', and must start and end with an alphanumeric character.
    """


    apiGroup?: str = "ipam.metal3.io"

    kind?: str = "IPPool"

    name: str


    check:
        len(apiGroup) <= 253 if apiGroup not in [None, Undefined]
        len(apiGroup) >= 1 if apiGroup not in [None, Undefined]
        _regex_match(str(apiGroup), r"^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$") if apiGroup
        len(kind) <= 63 if kind not in [None, Undefined]
        len(kind) >= 1 if kind not in [None, Undefined]
        _regex_match(str(kind), r"^[a-zA-Z]([-a-zA-Z0-9]*[a-zA-Z0-9])?$") if kind
        len(name) <= 253
        len(name) >= 1
        _regex_match(str(name), r"^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$")


schema InfrastructureClusterxK8sIoV1beta2Metal3DataTemplateSpecNetworkDataNetworksIPV6SLAACItems0RoutesItems0Services:
    r"""
    services is a list of IPv6 services

    Attributes
    ----------
    dns : [str], default is Undefined, optional
        dns is a list of IPv6 DNS services
    dnsFromIPPool : str, default is Undefined, optional
        dnsFromIPPool is the name of the IPPool from which to get the DNS servers
    """


    dns?: [str]

    dnsFromIPPool?: str


    check:
        len(dns) >= 1 if dns
        len(dns) <= 512 if dns
        all i in dns { _regex_match(str(i), r"^(([0-9a-fA-F]{1,4}:){7,7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))$") if i } if dns
        len(dnsFromIPPool) <= 512 if dnsFromIPPool not in [None, Undefined]
        len(dnsFromIPPool) >= 1 if dnsFromIPPool not in [None, Undefined]


schema InfrastructureClusterxK8sIoV1beta2Metal3DataTemplateSpecNetworkDataServices:
    r"""
    services  is a structure containing lists of different types objects

    Attributes
    ----------
    dns : [str], default is Undefined, optional
        dns is a list of DNS services
    dnsFromIPPool : str, default is Undefined, optional
        dnsFromIPPool is the name of the IPPool from which to get the DNS servers
    """


    dns?: [str]

    dnsFromIPPool?: str


    check:
        len(dns) >= 1 if dns
        len(dns) <= 512 if dns
        all i in dns { _regex_match(str(i), r"((^((([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5]))$)|(^(([0-9a-fA-F]{1,4}:){7,7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))$))") if i } if dns
        len(dnsFromIPPool) <= 512 if dnsFromIPPool not in [None, Undefined]
        len(dnsFromIPPool) >= 1 if dnsFromIPPool not in [None, Undefined]


schema InfrastructureClusterxK8sIoV1beta2Metal3DataTemplateStatus:
    r"""
    status defines the observed state of Metal3DataTemplate.

    Attributes
    ----------
    indexes : [InfrastructureClusterxK8sIoV1beta2Metal3DataTemplateStatusIndexesItems0], default is Undefined, optional
        indexes contains the list of Metal3Machines and their assigned indexes
